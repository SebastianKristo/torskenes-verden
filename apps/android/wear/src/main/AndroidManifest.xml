<?xml version="1.0" encoding="utf-8"?>
<!-- Prompt 51 (ANDPLAT51): Wear OS-appen «Homelab» – frittstående (trenger bare nett), innlogging med QR fra FinansHub på telefonen. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Sjekk inn / «Hent meg»: posisjonen sendes bare med selve innsjekken (siste kjente posisjon, ingen sporing). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Talegjenkjenning (Glimt, handleliste) via systemets skjerm. -->
    <queries>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_wear51"
        android:roundIcon="@drawable/ic_wear51"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Fungerer uten telefonappen i nærheten. -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />

        <activity
            android:name=".WearMain51"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
