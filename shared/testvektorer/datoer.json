{
  "beskrivelse": "Fasit for tolking av norske dato- og tidsuttrykk (F-logikk L1). Samme fil kjøres mot serveren og web (test/testvektorer.test.js), og mot Swift og Kotlin når enhetstestene finnes (Fase 4 og 5).",
  "beslutning": "docs/opprydding/BESLUTNINGER.md Q17 og Q20",
  "felt": {
    "naa": "Referansetidspunkt med UTC-forskyvning. Lokal tid er Europe/Oslo. «I dag» er Oslo-datoen for dette tidspunktet.",
    "tekst": "Det brukeren skriver.",
    "dato": "Forventet dato (YYYY-MM-DD, Oslo-tid).",
    "tid": "Forventet klokkeslett (HH:MM) eller null når teksten ikke har noe klokkeslett.",
    "regel": "Hvilken regel under «regler» vektoren prøver."
  },
  "regler": {
    "relativ": "«i dag» = 0, «i morgen» = +1, «overmorgen» og «i overmorgen» = +2, «om N dager» = +N, «om en uke» = +7, «om to uker» = +14.",
    "ukedag": "«fredag» og «på fredag» = førstkommende fredag. Er det fredag i dag, gjelder i dag, med mindre teksten har et klokkeslett som allerede har passert. Da gjelder om 7 dager.",
    "neste-ukedag": "«neste fredag» = førstkommende fredag etter i dag (aldri i dag). Mandag 16.11 gir fredag 20.11 (om 4 dager). Fredag 20.11 gir 27.11.",
    "ukedag-neste-uke": "«fredag neste uke» = fredagen i uka (mandag–søndag) etter inneværende uke. Mandag 16.11 gir 27.11 (om 11 dager). Søndag 22.11 gir også 27.11.",
    "ukedag-om-to-uker": "«fredag om to uker» = fredagen i uka to uker etter inneværende uke (= «fredag neste uke» + 7).",
    "dato-uten-aar": "«15. mars», «15.3», «1. jan» = neste gang datoen kommer. Datoen i dag teller. 29. februar gir neste skuddår.",
    "klokkeslett": "«kl 14» = 14:00, «14:30» = 14:30, «kl. 9.30» = 09:30, «halv tre» = 14:30 (1–6 uten noe annet betyr ettermiddag), «kvart over ni» = 09:15.",
    "tid-uten-dato": "Klokkeslett uten dato = i dag hvis tiden ikke har passert, ellers i morgen.",
    "midnatt-sommertid": "«I dag» er alltid Oslo-datoen, også mellom 00 og 02 og rundt bytte til og fra sommertid."
  },
