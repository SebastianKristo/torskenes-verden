            "dayText": {
              "type": "string",
              "description": "«i natt», «natt til i går» …"
            },
            "bedtime": {
              "type": [
                "string",
                "null"
              ]
            },
            "asleepAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "wakeAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "range": {
              "type": [
                "string",
                "null"
              ]
            },
            "asleepMin": {
              "type": "integer"
            },
            "asleepText": {
              "type": "string"
            },
            "inBedMin": {
              "type": [
                "integer",
                "null"
              ]
            },
            "inBedText": {
              "type": [
                "string",
                "null"
              ]
            },
            "stages": {
              "type": "array",
              "description": "Tom når klokka ikke har målt stadier",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "label",
                  "min",
                  "text"
                ],
                "properties": {
                  "key": {
                    "enum": [
                      "deep",
                      "core",
                      "rem",
                      "awake"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "min": {
                    "type": "integer"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "avg7Min": {
          "type": [
            "integer",
            "null"
          ]
        },
        "avg7Text": {
          "type": [
            "string",
            "null"
          ]
        },
        "avg7Nights": {
          "type": "integer"
        }
      }
