{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/helse.schema.json",
  "title": "Helse (egne data)",
  "description": "Brukerens egen Helse-side: søvn i natt og snitt siste 7 netter, skritt og distanse i dag, økter, vekt og trender for perioden (uke = 7 dager, maned = 30). Alt er regnet ut på serveren (server/helse/regler.js) i Oslo-tid; klientene viser tekstfeltene. Bare brukerens egne data. ?periode=uke|maned.",
  "x-endpoint": "GET /api/helse",
  "type": "object",
  "required": [
    "date",
    "periode",
    "days",
    "from",
    "to",
    "empty",
    "today",
    "sleep",
    "workouts",
    "weight",
    "trends",
    "summary"
  ],
  "properties": {
    "date": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "periode": {
      "enum": [
        "uke",
        "maned"
      ]
    },
    "days": {
      "type": "integer"
    },
    "from": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "to": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "empty": {
      "type": "boolean",
      "description": "true når det ikke finnes helsedata ennå"
    },
    "mock": {
      "type": "boolean"
    },
    "updatedAt": {
      "anyOf": [
        {
          "$ref": "../common/types.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "today": {
      "type": "object",
      "required": [
        "steps",
        "stepsText",
        "distanceM",
        "distanceText"
      ],
      "properties": {
        "steps": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stepsText": {
          "type": [
            "string",
            "null"
          ]
        },
        "distanceM": {
          "type": [
            "integer",
            "null"
          ]
        },
        "distanceText": {
          "type": [
            "string",
            "null"
          ]
        },
        "activeKcal": {
          "type": [
            "integer",
            "null"
          ]
        },
        "activeKcalText": {
          "type": [
            "string",
            "null"
          ]
        },
        "exerciseMin": {
          "type": [
            "integer",
            "null"
          ]
        },
        "exerciseText": {
          "type": [
            "string",
            "null"
          ]
        },
        "restingHr": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "sleep": {
      "type": "object",
      "required": [
        "tonight",
        "last",
        "avg7Min",
        "avg7Text",
        "avg7Nights"
      ],
      "properties": {
        "tonight": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "night",
            "dayText",
            "asleepMin",
            "asleepText",
            "stages"
          ],
          "properties": {
            "night": {
              "$ref": "../common/types.schema.json#/$defs/date",
              "description": "Datoen man våknet (Oslo)"
            },
            "dayText": {
              "type": "string",
              "description": "«i natt», «natt til i går» …"
            },
            "bedtime": {
              "type": [
                "string",
                "null"
              ]
            },
            "asleepAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "wakeAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "range": {
              "type": [
