                "type": "object",
                "required": [
                  "key",
                  "label",
                  "min",
                  "text"
                ],
                "properties": {
                  "key": {
                    "enum": [
                      "deep",
                      "core",
                      "rem",
                      "awake"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "min": {
                    "type": "integer"
                  },
                  "text": {
                    "type": "string"
                  }
