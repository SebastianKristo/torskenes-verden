{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "receipt.schema.json",
  "title": "Felles kvitteringsformat (prompt 48)",
  "description": "Beløp i kroner som tall med punktum (24.9). Rabatter er negative beløp. Pant og tips er egne varelinjer. category_suggestion velges fra brukerens kategoriliste i FinansHub (ingen fritekst).",
  "type": "object",
  "required": ["merchant", "date", "total", "items"],
  "properties": {
    "merchant": { "type": "string", "maxLength": 120 },
    "org_number": { "type": ["string", "null"], "maxLength": 20 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": ["string", "null"], "pattern": "^\\d{2}:\\d{2}$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["description", "amount"],
        "properties": {
          "description": { "type": "string", "maxLength": 200 },
          "quantity": { "type": ["number", "null"] },
          "unit_price": { "type": ["number", "null"] },
          "amount": { "type": "number" }
        }
      }
    },
    "discounts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["description", "amount"],
        "properties": {
          "description": { "type": "string", "maxLength": 200 },
          "amount": { "type": "number" }
        }
      }
    },
    "subtotal": { "type": ["number", "null"] },
    "vat": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["rate", "amount"],
        "properties": {
          "rate": { "type": "number" },
          "amount": { "type": "number" }
        }
      }
    },
    "total": { "type": "number" },
    "payment_method": { "type": ["string", "null"], "maxLength": 40 },
    "category_suggestion": { "type": "string", "maxLength": 80 }
  }
}
