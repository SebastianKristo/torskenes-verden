{
  "$kommentar": "Eneste kilde for designverdier i web, iOS og Android. Endre her og kjør «npm run tokens». Nøklene er semantiske (hva verdien brukes til), aldri hex- eller nyansenavn. Nøkler som begynner med $ er kommentarer og metadata og leses ikke av generatoren. Se docs/designsystem.md.",
  "$versjon": 1,

  "color": {
    "$kommentar": "Stil (papir, glass) × modus (lys, mork). Stil er et appvalg; modus følger systemet eller brukerens valg. Verdier er #rrggbb eller rgba(r,g,b,a). Glass-flater med alfa ligger over glass.mork.surface (og et bakgrunnsbilde på web).",
    "papir": {
      "lys": {
        "surface": "#f3efe6",
        "surfaceRaised": "#fffdf8",
        "surfaceSunken": "#ebe5d8",
        "line": "#d8d1c2",
        "textPrimary": "#1b1a17",
        "textSecondary": "#5c5850",
        "textTertiary": "#8f897c",
        "accent": "#b23a2a",
        "onAccent": "#ffffff",
        "success": "#2f7a4f",
        "onSuccess": "#ffffff",
        "warning": "#a8661a",
        "onWarning": "#ffffff",
        "danger": "#b23a2a",
        "onDanger": "#ffffff",
        "focus": "#1b1a17",
        "surfaceField": "#ffffff",
        "surfaceChip": "#ece6da",
        "surfaceOverlay": "#fffdf8",
        "lineSubtle": "#e3ddcf",
        "info": "#2b5d8a",
        "onInfo": "#ffffff",
        "successSoft": "#e3eee5",
        "warningSoft": "#f4e8cf",
        "dangerSoft": "#f6dfd8",
        "$navInk": "Prompt 57: tekst og ikon på de inaktive fanene i den flytende fanelinjen (mørk pille i begge moduser). Hvit i lyst og mørkt tema; den gamle #b3ada1 er erstattet.",
        "navInk": "#ffffff",
        "scrim": "rgba(0,0,0,0.35)",
        "$hoyKontrast": "Brukes når brukeren har slått på økt kontrast (iOS «Increase Contrast», web prefers-contrast: more).",
        "highContrast": {
          "textSecondary": "#3f3b35",
          "textTertiary": "#5c5850",
          "line": "#8f897c"
        }
      },
      "mork": {
        "surface": "#16140f",
        "surfaceRaised": "#211e18",
        "surfaceSunken": "#1b1a17",
        "line": "#3a352c",
        "textPrimary": "#f3efe6",
        "textSecondary": "#a39d90",
        "textTertiary": "#8a8478",
        "accent": "#ec7a64",
        "onAccent": "#1b1a17",
        "success": "#6fbf8f",
        "onSuccess": "#1b1a17",
        "warning": "#e0a24a",
        "onWarning": "#1b1a17",
        "danger": "#f59a8f",
        "onDanger": "#1b1a17",
        "focus": "#ec7a64",
        "surfaceField": "#1c1a15",
        "surfaceChip": "#2a261f",
        "surfaceOverlay": "#211e18",
        "lineSubtle": "#3a352c",
        "info": "#a8d4fb",
        "onInfo": "#1b1a17",
        "successSoft": "rgba(111,191,143,0.16)",
        "warningSoft": "rgba(224,168,90,0.16)",
        "dangerSoft": "rgba(236,122,100,0.16)",
        "navInk": "#ffffff",
        "scrim": "rgba(0,0,0,0.5)",
        "highContrast": {
          "textSecondary": "#d6d0c4",
          "textTertiary": "#a39d90",
          "line": "#6b665c"
        }
      }
    },
    "glass": {
      "$lys": "Q13: Glass har bare mørk modus i dag og får ikke lys ennå. glass.lys peker derfor til papir.lys, slik at lys modus i glass-stilen gir lyst papir i stedet for udefinerte verdier.",
      "lys": { "$alias": "papir.lys" },
      "mork": {
        "surface": "#07080b",
        "surfaceRaised": "rgba(40,44,52,0.55)",
        "surfaceSunken": "rgba(255,255,255,0.06)",
        "line": "rgba(255,255,255,0.12)",
        "textPrimary": "#eef0f4",
        "textSecondary": "#8a93a6",
        "textTertiary": "#6e6e78",
        "accent": "#ff7a3d",
        "onAccent": "#1b1a17",
        "success": "#6fbf8f",
        "onSuccess": "#1b1a17",
        "warning": "#e0a24a",
        "onWarning": "#1b1a17",
        "danger": "#f59a8f",
        "onDanger": "#1b1a17",
        "focus": "#a8d4fb",
        "surfaceField": "#0b0e15",
        "surfaceChip": "rgba(255,255,255,0.08)",
        "surfaceOverlay": "rgba(18,25,38,0.86)",
        "lineSubtle": "#1f2736",
        "info": "#a8d4fb",
        "onInfo": "#1b1a17",
        "successSoft": "rgba(111,191,143,0.16)",
        "warningSoft": "rgba(224,168,90,0.16)",
        "dangerSoft": "rgba(236,122,100,0.16)",
        "navInk": "#ffffff",
        "scrim": "rgba(0,0,0,0.5)",
        "highContrast": {
          "textSecondary": "#c4cad6",
          "textTertiary": "#8a93a6",
          "line": "rgba(255,255,255,0.3)"
        }
      }
    }
  },

  "category": {
    "$kommentar": "Kategorifarger (moduler på dashbordet, abonnementskategorier, kalendere). Fyllfarger med onCategory som tekst/ikon oppå (≥ 4.5:1, testet). onCategoryLight er teksten på en lys farge brukeren har valgt selv (f.eks. per nyhetskilde): klienten velger onCategory eller onCategoryLight etter bakgrunnens luminans, og den beste av hvit og svart gir alltid minst 4,58:1. Like i alle stiler og moduser. Hentet fra dagens dashbordkort (web40.css --wc); energi (#d98c1f, 2.7:1 mot hvitt) er byttet til amber.",
    "onCategory": "#ffffff",
    "onCategoryLight": "#000000",
    "blue": "#2b5d8a",
    "red": "#d4231b",
    "purple": "#6b4fa0",
    "green": "#2f7a4f",
    "teal": "#1f7a6e",
    "pink": "#c2477a",
    "amber": "#a8661a",
    "brown": "#8a6a3a",
    "neutral": "#55524d"
  },

  "font": {
    "$kommentar": "Familier på web per stil. iOS og Android bruker systemfonten (SF / Roboto) med tekststilene under, så Dynamic Type og fontskalering virker.",
    "family": {
      "papir": {
        "sans": "Manrope, system-ui, sans-serif",
        "serif": "Newsreader, Georgia, serif",
        "mono": "'IBM Plex Mono', ui-monospace, monospace"
      },
      "glass": {
        "sans": "Outfit, system-ui, sans-serif",
        "serif": "Newsreader, Georgia, serif",
        "mono": "'JetBrains Mono', ui-monospace, monospace"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },

  "textStyle": {
    "$kommentar": "Skala 11/12/13/14/16/18/22/28/44. size og lineHeight i px/pt/sp. ios = nærmeste iOS-tekststil (skalerer med Dynamic Type). m3 = Material 3-stilene som får denne verdien på Android.",
    "caption":     { "size": 11, "lineHeight": 14, "weight": "medium",   "ios": "caption2",    "m3": ["labelSmall"] },
    "footnote":    { "size": 12, "lineHeight": 16, "weight": "regular",  "ios": "caption",     "m3": ["bodySmall", "labelMedium"] },
    "subheadline": { "size": 13, "lineHeight": 18, "weight": "regular",  "ios": "footnote",    "m3": [] },
    "callout":     { "size": 14, "lineHeight": 20, "weight": "regular",  "ios": "subheadline", "m3": ["bodyMedium", "labelLarge"] },
    "body":        { "size": 16, "lineHeight": 24, "weight": "regular",  "ios": "body",        "m3": ["bodyLarge", "titleSmall"] },
    "headline":    { "size": 18, "lineHeight": 24, "weight": "semibold", "ios": "headline",    "m3": ["titleMedium"] },
    "title3":      { "size": 22, "lineHeight": 28, "weight": "semibold", "ios": "title3",      "m3": ["titleLarge", "headlineSmall"] },
    "title2":      { "size": 28, "lineHeight": 34, "weight": "bold",     "ios": "title",       "m3": ["headlineMedium", "headlineLarge"] },
    "largeTitle":  { "size": 44, "lineHeight": 52, "weight": "bold",     "ios": "largeTitle",  "m3": ["displaySmall", "displayMedium", "displayLarge"] }
  },

  "space": {
    "$kommentar": "Avstander (px/pt/dp).",
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },

  "radius": {
    "$kommentar": "Hjørneradier. full = pille/sirkel.",
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "full": 999
  },

  "shadow": {
    "$kommentar": "Skygger. y og blur i px/pt; elevation i dp på Android. Farge er svart med alpha.",
    "low":  { "y": 1, "blur": 3,  "alpha": 0.08, "elevation": 1 },
    "mid":  { "y": 4, "blur": 12, "alpha": 0.12, "elevation": 3 },
    "high": { "y": 12, "blur": 32, "alpha": 0.2, "elevation": 8 }
  },

  "z": {
    "$kommentar": "Lag (z-index). Ingenting skal ligge over toast.",
    "base": 0,
    "raised": 10,
    "sticky": 100,
    "nav": 200,
    "sheet": 300,
    "toast": 400
  },

  "motion": {
    "$kommentar": "Varigheter i ms og easing som cubic-bezier(x1,y1,x2,y2). Ved «Reduser bevegelse» er alle varigheter 0 (reduced).",
    "duration": {
      "fast": 150,
      "normal": 250,
      "slow": 400
    },
    "reduced": 0,
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "enter": [0, 0, 0.2, 1],
      "exit": [0.4, 0, 1, 1]
    }
  },

  "effect": {
    "$kommentar": "Bare web: uskarphet bak hevede flater per stil (backdrop-filter).",
    "blurRaised": { "papir": 0, "glass": 12 }
  }
}
