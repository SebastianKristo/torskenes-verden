{
  "name": "homelab-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personlig homelab-dashboard («OS») med offentlig CV",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "node --test \"test/**/*.test.js\"",
    "eval": "node eval/run.mjs",
    "eval:receipts": "node tests/receipts/run.mjs",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e51/*.e2e.mjs\"",
    "a11y": "node test/ui51/a11y.mjs",
    "test:visual": "node test/ui51/visual.mjs",
    "reset-password": "node scripts/reset-password.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@desert-ant-labs/clear": "4.1.0",
    "@desert-ant-labs/core": "4.1.0",
    "@desert-ant-labs/emo": "4.1.0",
    "@desert-ant-labs/eye": "4.1.0",
    "@desert-ant-labs/gist": "4.1.0",
    "@desert-ant-labs/moderator": "4.1.0",
    "@desert-ant-labs/redact": "4.1.0",
    "@desert-ant-labs/tongue": "4.1.0",
    "@desert-ant-labs/voz": "4.1.0",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "hono": "^4.13.13",
    "imapflow": "2.2.1",
    "koffi": "3.2.1",
    "leaflet": "^1.9.4",
    "mailparser": "3.9.33",
    "node-ical": "^0.27.3",
    "onnxruntime-node": "1.30.0",
    "satellite.js": "^7.1.0",
    "topojson-client": "^3.1.0",
    "undici": "^8.12.2",
    "world-atlas": "^2.0.2",
    "ws": "^8.18.0"
  }
}
