# Generer med: npm run hash-password -- 'ditt passord'
APP_PASSWORD_HASH=
# Minst 32 tilfeldige tegn: openssl rand -hex 32
SESSION_SECRET=
# Sett til false kun ved lokal utvikling uten HTTPS
COOKIE_SECURE=true
USER_NAME=Sebastian

# Trading 212: Key ID + secret (nye nøkler), og miljøet nøkkelen er laget i (live eller demo)
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ENV=live
HA_URL=http://192.168.1.20:8123
HA_TOKEN=
HA_SENSOR_POWER=sensor.power_now
HA_SENSOR_ENERGY_DAILY=sensor.energy_daily
HA_SENSOR_PRICE=sensor.nordpool_kwh_oslo_nok
HOMEY_URL=https://my.homey.app
SCHOOL_ICAL_URL=
SCHOOL_URL=https://www.vilbli.no
MAZEMAP_CAMPUS_ID=
NASA_API_KEY=
ENTUR_CLIENT_NAME=benjamin-homelab
MET_USER_AGENT=homelab-dashboard/1.0 benjamin@kristo.no
LABDECK_URL=http://192.168.1.50

# Sonarr/Radarr («Kommer ut»). Alt under «Integrasjoner» kan også settes i Innstillinger på siden.
SONARR_URL=http://192.168.1.20:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.1.20:7878
RADARR_API_KEY=

# Plex og Jellyfin (kortet «Media»). Kan også settes i Innstillinger → Integrasjoner → Media.
# Plex-token: åpne et element i Plex → ⋯ → Hent info → Vis XML; tokenet står etter X-Plex-Token= i adressen.
PLEX_URL=http://192.168.1.20:32400
PLEX_TOKEN=
# Jellyfin: Kontrollpanel → Avansert → API-nøkler → +. Brukernavnet brukes til «Nylig lagt til».
JELLYFIN_URL=http://192.168.1.20:8096
JELLYFIN_API_KEY=
JELLYFIN_USER=
# SEARCH_URL=https://www.google.com/search?q=
# SAT_GROUP=starlink

# Helsesjekk (valgfritt å overstyre)
ROUTER_URL=http://192.168.1.1
PROXMOX_URL=https://192.168.1.10:8006
PIHOLE_URL=http://192.168.1.30/admin
NAS_URL=http://192.168.1.40:5000

# Valgfritt: egne Ruter-strekninger, én per linje: Fra (NSR-ID) > Til (NSR-ID)
# Enklest å endre i Innstillinger → Integrasjoner.

# Docker compose: token fra Cloudflare Zero Trust → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# Demo uten eksterne API-er
# MOCK_DATA=1

# FinansHub – AI-utlesing av kvitteringer (kan også settes i FinansHub → Innstillinger → AI-motor)
AI_PROVIDER=ollama          # ollama | gemini
AI_FALLBACK=gemini          # gemini | none
AI_MIN_CONFIDENCE=0.85
OLLAMA_URL=http://192.168.1.30:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=120
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_UPLOAD_MB=40

# Valgfritt: 64 hex-tegn for kryptering av 2FA-hemmeligheter (ellers avledet fra SESSION_SECRET)
TOTP_ENC_KEY=
# Valgfritt: nøkkel for krypterte hemmeligheter i FinansHub (ellers avledet fra SESSION_SECRET)
SECRET_KEY=

# Kvitteringer fra e-post (Proton Mail via Bridge). Start Bridge med: docker compose --profile mail up -d
# Se docs/finanshub.md for oppsett. Kan også settes i Innstillinger → Integrasjoner → Proton Mail.
IMAP_HOST=protonmail-bridge
IMAP_PORT=143
IMAP_SECURITY=starttls
IMAP_USER=
# Bridge-passordet fra «info» i Bridge – ikke Proton-passordet
IMAP_PASSWORD=
IMAP_FOLDER=Folders/Kvitteringer
IMAP_DONE_FOLDER=Folders/Kvitteringer/Lest
IMAP_POLL_MINUTES=10
# IMAP_FINN_FOLDER=Folders/Finn

# Prompt 51 (OBS51): drift (docs/drift-51.md)
# ntfy (selvhostet push). Start: docker compose --profile ntfy up -d. Tokenet lages i ntfy-containeren (se docs) og sendes aldri til appene.
NTFY_URL=
# NTFY_URL=http://ntfy:80
NTFY_PUBLIC_URL=
# NTFY_PUBLIC_URL=http://192.168.1.10:2586   (adressen telefonene på hjemmenettet bruker)
NTFY_TOKEN=
NTFY_BIND=127.0.0.1
# Spor: forespørsler over denne grensen (ms) lagres i ringbufferen. OBS51_TRACE=0 slår sporene av.
OBS51_SLOW_MS=800
# OBS51_BACKGROUND=0 slår av samples, driftsvarsler og selvreparasjon i bakgrunnen.

# Prompt 51 (QA51): kvalitet (docs/kvalitet-51.md)
# Krasjrapporter tas alltid imot på POST /api/crash og lagres lokalt. Med GlitchTip (docker compose --profile glitchtip up -d)
# videresendes de dit. DSN-en finner du i GlitchTip under prosjektet → Settings → Client Keys (bruk vertsnavnet glitchtip:8000).
GLITCHTIP_DSN=
# GLITCHTIP_DSN=http://<nøkkel>@glitchtip:8000/1
# Lag med: openssl rand -hex 32  (begge må settes før første oppstart av GlitchTip)
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_BIND=127.0.0.1
GLITCHTIP_PORT=8010
# GLITCHTIP_PUBLIC_URL=http://192.168.1.10:8010   (adressen du åpner GlitchTip på hjemme)
# GLITCHTIP_ALLOW_EXTERNAL=1 bare hvis GlitchTip ligger utenfor huset (da forlater krasjrapporter huset).

# Prompt 51 (OPS51): backup og oppdateringer (docs/backup-oppdatering-51.md)
# Mål, NAS/offsite-nøkler og repo-passordet settes i appen (Innstillinger → System → Backup og oppdateringer), ikke her.
# BACKUP_DIR=/srv/backup   (egen disk; restic-repoet blir BACKUP_DIR/restic51)
# Staging-kanalen (leses bare av updateren): 1 = ny versjon røyktestes i en kopi før byttet.
UPDATE_STAGING=1
# STAGING_PORT=3001        (gjør staging synlig mens den står klar; standard ingen port)
# STAGING_BIND=127.0.0.1
BRREG51_AUTO=1  # 0 = ingen ukentlig nedlasting av Enhetsregisteret

# Prompt 51 (MEDFAM51): Familie og Media (docs/media-familie-51.md)
# Bazarr (norske undertekster): docker compose --profile bazarr up -d. Nøkkelen finner du i Bazarr → Settings → General → Security.
BAZARR_URL=
# BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=
BAZARR_BIND=127.0.0.1
# Audiobookshelf (lydbøker og podkaster): docker compose --profile audiobookshelf up -d. Token: Audiobookshelf → Settings → Users → (admin) → API Token.
ABS_URL=
# ABS_URL=http://audiobookshelf:80
ABS_TOKEN=
ABS_BIND=127.0.0.1
# ABS_PUBLIC_URL=http://192.168.1.10:13378   (lenken «Fortsett i Audiobookshelf» – bare på hjemmenettet)
# Mediemappa på verten, montert i Bazarr på SAMME sti som Sonarr/Radarr ser den (ellers finner ikke Bazarr filene):
# MEDIA_DIR=/srv/media
# MEDIA_PATH_IN_ARR=/data/media
# AUDIOBOOKS_DIR=/srv/media/lydbøker
# PODCASTS_DIR=/srv/media/podkaster
# Lagring: «sett og stort» fra denne størrelsen (GB). Papirkurv: mappe i os-containeren + hvordan Sonarr/Radarr-stier ser ut der.
MEDFAM51_BIG_GB=8
# MEDFAM51_TRASH_DIR=/media/.papirkurv
# MEDFAM51_PATH_MAP=/data/media=/media   (sti i Sonarr/Radarr = sti i os; samme disk som papirkurven, ellers brukes Sonarr/Radarr-sletting)
